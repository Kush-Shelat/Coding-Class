# Define two sets (you can also use lists like)
set_a = {1, 2, 3, 4, 5}
set_b = {4, 5, 6, 7, 8}

# Create an empty list to store the final difference
difference = []

# Look at each item in the first set one by one
for item_a in set_a:
    # Assume the item is NOT in the second set yet
    found_in_b = False
    
    # Check it against every item in the second set
    for item_b in set_b:
        if item_a == item_b:
            found_in_b = True
            
    # If we checked all of set_b and never found a match, keep the item
    if found_in_b == False:
        difference.append(item_a)
    else:
        # Optional: just showing how else fits in
        pass

# Print the final result
print("Items in Set A that are not in Set B:")
print(difference)